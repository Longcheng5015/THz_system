    <!-- Calibration Config Panel -->
    <item>
     <widget class="QGroupBox" name="grp_config">
      <property name="title">
       <string>Calibration Settings &amp; Parameters</string>
      </property>
      <layout class="QGridLayout" name="grid_config">
       <item row="0" column="0">
        <widget class="QLabel" name="lbl_scan_mode">
         <property name="text">
          <string>Calibration Mode:</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QComboBox" name="combo_scan_mode">
         <item>
          <property name="text">
           <string>Power</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Polarization</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="0" column="2">
        <widget class="QLabel" name="lbl_polar_search">
         <property name="text">
          <string>Polar Search Algo:</string>
         </property>
        </widget>
       </item>
       <item row="0" column="3">
        <widget class="QComboBox" name="combo_polar_search">
         <item>
          <property name="text">
           <string>Sequential Step (Option A)</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Binary Search (Option B)</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="0" column="4">
        <widget class="QLabel" name="lbl_target_power">
         <property name="text">
          <string>Target Power (mW):</string>
         </property>
        </widget>
       </item>
       <item row="0" column="5">
        <widget class="QDoubleSpinBox" name="spin_target_power">
         <property name="decimals">
          <number>3</number>
         </property>
         <property name="maximum">
          <double>10000.000000000000000</double>
         </property>
         <property name="value">
          <double>5.000000000000000</double>
         </property>
        </widget>
       </item>
       <item row="0" column="6">
        <widget class="QLabel" name="lbl_power_tol">
         <property name="text">
          <string>Tolerance (mW):</string>
         </property>
        </widget>
       </item>
       <item row="0" column="7">
        <widget class="QDoubleSpinBox" name="spin_power_tol">
         <property name="decimals">
          <number>3</number>
         </property>
         <property name="maximum">
          <double>100.000000000000000</double>
         </property>
         <property name="value">
          <double>0.050000000000000</double>
         </property>
        </widget>
       </item>
       <item row="0" column="8">
        <widget class="QLabel" name="lbl_wait_time">
         <property name="text">
          <string>Wait Time (s):</string>
         </property>
        </widget>
       </item>
       <item row="0" column="9">
        <widget class="QDoubleSpinBox" name="spin_wait_time">
         <property name="decimals">
          <number>1</number>
         </property>
         <property name="maximum">
          <double>3600.000000000000000</double>
         </property>
         <property name="value">
          <double>10.000000000000000</double>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>

