              </font>
             </property>
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Scan log&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Test conditions of each scan and its key events (fixed stages, fitted model, angles where the target was not reached, readings that did not settle, lock-in over full scale, data files, how the scan ended), shown live. Point-by-point readings are in the log on the Calibration tab.&lt;/p&gt;&lt;p&gt;Every line is also appended to ScanLog_YYYY-MM-DD.txt in the data save folder.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="readOnly">
              <bool>true</bool>
             </property>
