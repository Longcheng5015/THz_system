             </item>

             <item row="3" column="0">
              <widget class="QLabel" name="lbl_s2_no">
               <property name="text">
                <string>Step NO.:</string>
               </property>
              </widget>
             </item>
             <item row="3" column="1" colspan="2">
              <widget class="QSpinBox" name="spin_stage2_no">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>10000</number>
               </property>
               <property name="value">
                <number>91</number>
               </property>
              </widget>
             </item>

