               </property>
              </widget>
             </item>
             <item row="2" column="1" colspan="2">
              <widget class="QDoubleSpinBox" name="spin_stage2_step">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="minimum">
                <double>-360.0</double>
               </property>
               <property name="maximum">
                <double>360.0</double>
