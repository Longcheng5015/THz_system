       </layout>
      </widget>
      <widget class="QWidget" name="tab_2">
       <attribute name="title">
        <string>Inst. Config.</string>
       </attribute>
       <layout class="QGridLayout" name="tab2Layout" columnstretch="0,1">
        <item row="0" column="0">
         <widget class="QGroupBox" name="connGroup">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Preferred" vsizetype="Maximum">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="title">
           <string>Instrument Connections</string>
          </property>
          <layout class="QGridLayout" name="connGrid" columnstretch="0,1">
           <item row="0" column="0" colspan="2" alignment="Qt::AlignRight">
            <widget class="QPushButton" name="btn_scan_devices">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
               <horstretch>0</horstretch>
               <verstretch>0</verstretch>
              </sizepolicy>
             </property>
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Scan devices&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Lists the PM100D power meters (USB), the lock-ins on GPIB and serial ports and the Thorlabs Kinesis serial numbers currently visible to this PC, and offers them in the drop-down lists. The values already entered are kept.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Scan devices</string>
             </property>
            </widget>
