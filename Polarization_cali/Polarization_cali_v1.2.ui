      <widget class="QWidget" name="tab">
       <attribute name="title">
        <string>Calibration</string>
       </attribute>
       <layout class="QVBoxLayout" name="mainLayout">
        <!-- Top Unified Instrument Connection Panel -->
        <item>
         <widget class="QGroupBox" name="grp_pm100d">
          <property name="title">
           <string>Hardware Instrument Connections</string>
          </property>
          <layout class="QHBoxLayout" name="layout_detector">
           <item>
            <widget class="QCheckBox" name="chk_detector_enable">
             <property name="toolTip">
              <string>Use the detector chosen on the right (PM100D power meter or lock-in) for the power reading. Unchecked: no detector is connected or read.</string>
             </property>
             <property name="text">
              <string>Detector</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="combo_detector">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Detector&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;PM100D&lt;/b&gt;: thermal power meter, reading in mW (absolute power).&lt;/p&gt;&lt;p&gt;&lt;b&gt;Lock-in&lt;/b&gt;: an SR830 reads a fast detector (APD, PMT, one channel of a balanced detector) at the laser's 1 kHz trigger, connected to REF IN with the reference set to External. The reading is R (independent of the phase) in mV, proportional to the power but not calibrated in mW. Target and tolerances are then in mV.&lt;/p&gt;&lt;p&gt;Conn. Inst. connects the detector selected here; its address is set in Inst. Config.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
             <item>
              <property name="text">
               <string>PM100D</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Lock-in</string>
              </property>
             </item>
            </widget>
           </item>
           <item>
            <widget class="LedIndicator" name="led_detector" native="true">
             <property name="minimumSize">
              <size>
               <width>28</width>
               <height>28</height>
              </size>
             </property>
             <property name="maximumSize">
              <size>
               <width>28</width>
               <height>28</height>
              </size>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="pm_led_spacer">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
             <property name="sizeType">
              <enum>QSizePolicy::Fixed</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>20</width>
               <height>0</height>
              </size>
             </property>
            </spacer>
           </item>
           <item>
            <widget class="QWidget" name="widget_pm_settings">
             <layout class="QHBoxLayout" name="layout_pm_settings">
             <property name="leftMargin">
              <number>0</number>
             </property>
             <property name="topMargin">
              <number>0</number>
             </property>
             <property name="rightMargin">
              <number>0</number>
             </property>
             <property name="bottomMargin">
              <number>0</number>
             </property>
              <item>
               <widget class="QLabel" name="lbl_pm_wavelength">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Wavelength (nm) - default 800 nm&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Set it to the laser wavelength. The meter uses it to correct the reading with the sensor's calibration data; it does not select what the sensor detects.&lt;/p&gt;&lt;p&gt;Sent to the meter when the meter connects, and again every time you finish editing (Enter, or leaving the box). The value the meter accepted is shown back here. The limits of the box follow the connected sensor (S302C: 185 - 20000 nm).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Wavelength (nm):</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QSpinBox" name="spin_pm_wavelength">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Wavelength (nm) - default 800 nm&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Set it to the laser wavelength. The meter uses it to correct the reading with the sensor's calibration data; it does not select what the sensor detects.&lt;/p&gt;&lt;p&gt;Sent to the meter when the meter connects, and again every time you finish editing (Enter, or leaving the box). The value the meter accepted is shown back here. The limits of the box follow the connected sensor (S302C: 185 - 20000 nm).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="buttonSymbols">
                 <enum>QAbstractSpinBox::NoButtons</enum>
                </property>
                <property name="minimum">
                 <number>185</number>
                </property>
                <property name="maximum">
                 <number>20000</number>
                </property>
                <property name="value">
                 <number>800</number>
                </property>
               </widget>
              </item>
              <item>
               <spacer name="pm_wl_spacer">
                <property name="orientation">
                 <enum>Qt::Horizontal</enum>
                </property>
                <property name="sizeType">
                 <enum>QSizePolicy::Fixed</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>12</width>
                  <height>0</height>
                 </size>
                </property>
               </spacer>
              </item>
              <item>
               <widget class="QLabel" name="lbl_pm_range">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Power range&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Auto: the meter picks the range itself (recommended).&lt;/p&gt;&lt;p&gt;A fixed range stops the meter from switching ranges; a power above it reads as over-range. The ranges are read from the meter when it connects and whenever the wavelength changes: they depend on the sensor and shift slightly with the wavelength (S302C at 800 nm: 3.695 mW, 34.99 mW, 347.9 mW, 3.477 W).&lt;/p&gt;&lt;p&gt;Applied to the meter at once.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Power range:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="combo_pm_range">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Power range&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Auto: the meter picks the range itself (recommended).&lt;/p&gt;&lt;p&gt;A fixed range stops the meter from switching ranges; a power above it reads as over-range. The ranges are read from the meter when it connects and whenever the wavelength changes: they depend on the sensor and shift slightly with the wavelength (S302C at 800 nm: 3.695 mW, 34.99 mW, 347.9 mW, 3.477 W).&lt;/p&gt;&lt;p&gt;Applied to the meter at once.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="minimumContentsLength">
                 <number>8</number>
                </property>
                <item>
                 <property name="text">
                  <string>Auto</string>
                 </property>
                </item>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="widget_lockin_settings">
             <layout class="QHBoxLayout" name="layout_lockin_settings">
             <property name="leftMargin">
              <number>0</number>
             </property>
             <property name="topMargin">
              <number>0</number>
             </property>
             <property name="rightMargin">
              <number>0</number>
             </property>
             <property name="bottomMargin">
              <number>0</number>
             </property>
              <item>
               <widget class="QLabel" name="lbl_lockin_sens">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Lock-in sensitivity&lt;/b&gt; (full scale)&lt;/p&gt;&lt;p&gt;Choose one above the largest signal of the scan: the readout shows the signal in % of full scale, and above 100 % the reading may be clipped (the scan log warns). Read from the lock-in when it connects, applied at once when changed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Sensitivity:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="combo_lockin_sens">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Lock-in sensitivity&lt;/b&gt; (full scale)&lt;/p&gt;&lt;p&gt;Choose one above the largest signal of the scan: the readout shows the signal in % of full scale, and above 100 % the reading may be clipped (the scan log warns). Read from the lock-in when it connects, applied at once when changed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="minimumContentsLength">
                 <number>10</number>
                </property>
               </widget>
              </item>
              <item>
               <spacer name="lockin_sens_spacer">
                <property name="orientation">
                 <enum>Qt::Horizontal</enum>
                </property>
                <property name="sizeType">
                 <enum>QSizePolicy::Fixed</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>12</width>
                  <height>0</height>
                 </size>
                </property>
               </spacer>
              </item>
              <item>
               <widget class="QLabel" name="lbl_lockin_tc">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Lock-in time constant&lt;/b&gt;&lt;/p&gt;&lt;p&gt;After a stage move the output needs about 5 time constants to settle. Keep Stable Window at least 5 x the time constant and Refresh at least the time constant (faster readings are not independent). Longer: less noise, slower scan. Read from the lock-in when it connects, applied at once when changed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Time const.:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="combo_lockin_tc">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Lock-in time constant&lt;/b&gt;&lt;/p&gt;&lt;p&gt;After a stage move the output needs about 5 time constants to settle. Keep Stable Window at least 5 x the time constant and Refresh at least the time constant (faster readings are not independent). Longer: less noise, slower scan. Read from the lock-in when it connects, applied at once when changed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="minimumContentsLength">
                 <number>6</number>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <spacer name="refresh_spacer">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
             <property name="sizeType">
              <enum>QSizePolicy::Fixed</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>12</width>
               <height>0</height>
              </size>
             </property>
            </spacer>
           </item>
           <item>
            <widget class="QLabel" name="lbl_pm_refresh">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Refresh interval (ms)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;How often the detector is read. While no scan is running: the reading and the stage positions are shown at this interval. During a scan: the stability check reads the detector at this interval (the value at Start), see Stable Window.&lt;/p&gt;&lt;p&gt;The thermal sensor needs several seconds to follow a power change, so reading faster than about 500 ms shows little new. With the lock-in, use at least the time constant.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Refresh (ms):</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QSpinBox" name="spin_pm_refresh">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
               <horstretch>0</horstretch>
               <verstretch>0</verstretch>
              </sizepolicy>
             </property>
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Refresh interval (ms)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;How often the detector is read. While no scan is running: the reading and the stage positions are shown at this interval. During a scan: the stability check reads the detector at this interval (the value at Start), see Stable Window.&lt;/p&gt;&lt;p&gt;The thermal sensor needs several seconds to follow a power change, so reading faster than about 500 ms shows little new. With the lock-in, use at least the time constant.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="buttonSymbols">
              <enum>QAbstractSpinBox::NoButtons</enum>
             </property>
             <property name="minimum">
              <number>100</number>
             </property>
             <property name="maximum">
              <number>10000</number>
             </property>
             <property name="singleStep">
              <number>100</number>
             </property>
             <property name="value">
              <number>500</number>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="pm_power_spacer">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </spacer>
           </item>
          </layout>
         </widget>
        </item>

        <!-- Side-by-Side 3 Stage Boxes Layout (Left to Right) -->
        <item>
         <layout class="QHBoxLayout" name="layout_three_stages">
          
          <!-- Stage 1 GroupBox (Left) -->
          <item>
           <widget class="QGroupBox" name="grp_stage1">
            <property name="title">
             <string>Stage 1 (1/2 Waveplate)</string>
            </property>
            <layout class="QGridLayout" name="grid_s1">
             <item row="0" column="0">
              <widget class="QCheckBox" name="chk_stage1_enable">
               <property name="text">
                <string>Enable Stage 1</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="LedIndicator" name="led_stage1" native="true"/>
             </item>
             <item row="0" column="3" colspan="2">
              <widget class="QPushButton" name="btn_home_stage1">
               <property name="text">
                <string>Home Stage 1</string>
               </property>
              </widget>
             </item>

             <item row="1" column="0">
              <widget class="QLabel" name="lbl_s1_start">
               <property name="text">
                <string>Start (°):</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1" colspan="2">
              <widget class="QDoubleSpinBox" name="spin_stage1_start">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="minimum">
                <double>-360.0</double>
               </property>
               <property name="maximum">
                <double>360.0</double>
               </property>
               <property name="value">
                <double>0.0</double>
               </property>
              </widget>
             </item>

             <item row="2" column="0">
              <widget class="QLabel" name="lbl_s1_step">
               <property name="text">
                <string>Step (°):</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1" colspan="2">
              <widget class="QDoubleSpinBox" name="spin_stage1_step">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="minimum">
                <double>-360.0</double>
               </property>
               <property name="maximum">
                <double>360.0</double>
               </property>
               <property name="value">
                <double>5.0</double>
               </property>
              </widget>
             </item>

             <item row="3" column="0">
              <widget class="QLabel" name="lbl_s1_no">
               <property name="text">
                <string>Step NO.:</string>
               </property>
              </widget>
             </item>
             <item row="3" column="1" colspan="2">
              <widget class="QSpinBox" name="spin_stage1_no">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>10000</number>
               </property>
               <property name="value">
                <number>19</number>
               </property>
              </widget>
             </item>

             <item row="4" column="0" colspan="5">
              <widget class="QLabel" name="lbl_stage1_pos">
               <property name="font">
                <font>
                 <bold>true</bold>
                </font>
               </property>
               <property name="text">
                <string>Pos: -- °</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignCenter</set>
               </property>
              </widget>
             </item>

             <item row="5" column="0">
              <widget class="QLabel" name="lbl_s1_goto">
               <property name="text">
                <string>Target (°):</string>
               </property>
              </widget>
             </item>
             <item row="5" column="1" colspan="2">
              <widget class="QDoubleSpinBox" name="spin_stage1_goto">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="minimum">
                <double>-360.0</double>
               </property>
               <property name="maximum">
                <double>360.0</double>
               </property>
              </widget>
             </item>
             <item row="5" column="3" colspan="2">
              <widget class="QPushButton" name="btn_stage1_goto">
               <property name="text">
                <string>Move To</string>
               </property>
              </widget>
             </item>

             <item row="6" column="0">
              <widget class="QLabel" name="lbl_s1_rel">
               <property name="text">
                <string>Rel Step (°):</string>
               </property>
              </widget>
             </item>
             <item row="6" column="1" colspan="2">
              <widget class="QDoubleSpinBox" name="spin_stage1_rel">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="value">
                <double>1.0</double>
               </property>
