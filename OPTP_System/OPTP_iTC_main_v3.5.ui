                     <property name="verticalSpacing">
                      <number>0</number>
                     </property>
                     <item row="0" column="4">
                      <widget class="QPushButton" name="fmManual">
                       <property name="sizePolicy">
                        <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                         <horstretch>0</horstretch>
                         <verstretch>0</verstretch>
                        </sizepolicy>
                       </property>
                       <property name="minimumSize">
                        <size>
                         <width>0</width>
                         <height>28</height>
                        </size>
                       </property>
                       <property name="maximumSize">
                        <size>
                         <width>16777215</width>
                         <height>45</height>
                        </size>
                       </property>
                       <property name="font">
                        <font>
                         <pointsize>10</pointsize>
                        </font>
                       </property>
                       <property name="toolTip">
                        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Manual block / pass (for alignment and testing)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Press to block the beam, press again to let it pass. The text shows the current state: Blocked or Pass.&lt;/p&gt;&lt;p&gt;Which position is pass follows the CH1/CH2 box. Disabled during a scan, when Auto block is in charge.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                       </property>
                       <property name="text">
                        <string>Block / Pass</string>
                       </property>
                       <property name="checkable">
                        <bool>true</bool>
                       </property>
                       <property name="checked">
                        <bool>false</bool>
                       </property>
                       <property name="mytype" stdset="0">
                        <string>checkable_button</string>
                       </property>
                      </widget>
                     </item>
                     <item row="0" column="3">
                      <widget class="QPushButton" name="AutoBlock">
                       <property name="sizePolicy">
                        <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                         <horstretch>0</horstretch>
                         <verstretch>0</verstretch>
                        </sizepolicy>
                       </property>
                       <property name="minimumSize">
                        <size>
                         <width>0</width>
                         <height>28</height>
                        </size>
                       </property>
                       <property name="maximumSize">
                        <size>
                         <width>16777215</width>
                         <height>45</height>
                        </size>
                       </property>
                       <property name="font">
                        <font>
                         <pointsize>10</pointsize>
                        </font>
                       </property>
                       <property name="toolTip">
                        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Auto block (protects the sample during temperature changes)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;When pressed, during a scan the flip mount blocks the beam while the temperature is changing and settling, lets it pass right before the measurement at each temperature point, and blocks it again when the scan finishes, is stopped or fails.&lt;/p&gt;&lt;p&gt;A scan will not start with Auto block on while the flip mount is not connected.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                       </property>
                       <property name="text">
                        <string>AutoBlock</string>
                       </property>
                       <property name="checkable">
                        <bool>true</bool>
                       </property>
                       <property name="checked">
                        <bool>false</bool>
                       </property>
                       <property name="mytype" stdset="0">
                        <string>checkable_button</string>
                       </property>
                      </widget>
