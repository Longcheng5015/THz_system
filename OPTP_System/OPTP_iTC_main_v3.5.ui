                          <string>label</string>
                         </property>
                        </widget>
                       </item>
                       <item>
                        <widget class="QComboBox" name="scanMode">
                         <property name="sizePolicy">
                          <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                           <horstretch>0</horstretch>
                           <verstretch>0</verstretch>
                          </sizepolicy>
                         </property>
                         <property name="maximumSize">
                          <size>
                           <width>16777215</width>
                           <height>16777215</height>
                          </size>
                         </property>
                         <property name="toolTip">
                          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Scan modes&lt;/span&gt; (loop order: outermost → innermost)&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;'THz_Scan'&lt;/span&gt;: THz time-domain scan - stage1 sweeps the THz waveform, stage2 normally holds one pump delay. Order: rotation stages → stage1 → stage2.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;'1D_THz'&lt;/span&gt;: pump-probe 1D scan - stage1 fixed at the THz peak (iPos1), stage2 sweeps the pump delay. Order: rotation stages → stage1 → stage2.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;'POL_2D'&lt;/span&gt;: polarization-dependent scan - at each fixed stage1 / stage2 point the rotation stages sweep the polarization (same mode name as MO). Order: stage1 → stage2 → rotation stages.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;'2D_THz'&lt;/span&gt;: 2D scan - one full THz waveform (stage1) at each pump delay (stage2). Order: rotation stages → stage2 → stage1.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Temperature scans&lt;/span&gt;: with Drift comp. on (Inst. Config. → Peak search), every mode shifts iPos1 / iPos2 by the THz peak drift at each temperature point.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                         </property>
                        </widget>
                       </item>
                      </layout>
                     </item>
