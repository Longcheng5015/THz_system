                        </size>
                       </property>
                       <property name="font">
                        <font>
                         <pointsize>10</pointsize>
                        </font>
                       </property>
                       <property name="toolTip">
                        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Record pump power into the data files&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Works together with AutoBlock. When both are pressed, the pump power is measured right before the beam is let through to the sample, while the beam is still blocked and falls on the power meter: at every temperature point, or once before a scan without temperature points.&lt;/p&gt;&lt;p&gt;The mean, standard deviation and the N readings are saved in the data file of that point and in the ScanLog.&lt;/p&gt;&lt;p&gt;A scan will not start with Record and AutoBlock on while the power meter is not connected. Without AutoBlock nothing is recorded.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                       </property>
                       <property name="text">
                        <string>Record</string>
                       </property>
                       <property name="checkable">
                        <bool>true</bool>
                       </property>
                       <property name="checked">
                        <bool>false</bool>
                       </property>
                       <property name="mytype" stdset="0">
                        <string>checkable_button</string>
                       </property>
                      </widget>
                     </item>
                     <item row="0" column="6">
