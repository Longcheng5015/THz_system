                 </spacer>
                </item>
               </layout>
              </widget>
              <widget class="QWidget" name="configTab2">
               <attribute name="title">
                <string>PM config</string>
               </attribute>
               <layout class="QGridLayout" name="pmGrid" columnstretch="0,1">
                <item row="0" column="0">
                 <widget class="QLabel" name="pmLabel_wl">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Wavelength (nm) - default 800 nm&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Set it to the pump wavelength. The meter uses it to correct the reading with the sensor's calibration data; it does not select what the sensor detects.&lt;/p&gt;&lt;p&gt;Sent to the meter when the meter connects, and again every time you finish editing (Enter, or leaving the box). The value the meter accepted is shown back here.&lt;/p&gt;&lt;p&gt;The S302C thermal sensor accepts any value from 185 to 20000 nm and responds almost equally over that range, so the correction is small; a photodiode sensor has a narrower range and depends strongly on the wavelength. The limits of the box follow the connected sensor.&lt;/p&gt;&lt;p&gt;Whole nanometres only. Preset wavelengths shown on the meter's front panel or in the Thorlabs software are just shortcuts there; the meter itself accepts any value within the range.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Wavelength (nm)</string>
                  </property>
                  <property name="mytype" stdset="0">
                   <string>label</string>
                  </property>
                 </widget>
                </item>
                <item row="0" column="1">
                 <widget class="QSpinBox" name="pmWavelength">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="minimumSize">
                   <size>
                    <width>0</width>
                    <height>24</height>
                   </size>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Wavelength (nm) - default 800 nm&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Set it to the pump wavelength. The meter uses it to correct the reading with the sensor's calibration data; it does not select what the sensor detects.&lt;/p&gt;&lt;p&gt;Sent to the meter when the meter connects, and again every time you finish editing (Enter, or leaving the box). The value the meter accepted is shown back here.&lt;/p&gt;&lt;p&gt;The S302C thermal sensor accepts any value from 185 to 20000 nm and responds almost equally over that range, so the correction is small; a photodiode sensor has a narrower range and depends strongly on the wavelength. The limits of the box follow the connected sensor.&lt;/p&gt;&lt;p&gt;Whole nanometres only. Preset wavelengths shown on the meter's front panel or in the Thorlabs software are just shortcuts there; the meter itself accepts any value within the range.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="buttonSymbols">
                   <enum>QAbstractSpinBox::ButtonSymbols::NoButtons</enum>
                  </property>
                  <property name="minimum">
                   <number>185</number>
                  </property>
                  <property name="maximum">
                   <number>20000</number>
                  </property>
                  <property name="value">
                   <number>800</number>
                  </property>
                  <property name="mytype" stdset="0">
                   <string>intNO</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QLabel" name="pmLabel_range">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Power range&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Auto: the meter picks the range itself (recommended).&lt;/p&gt;&lt;p&gt;A fixed range stops the meter from switching ranges; a power above it reads as over-range. The ranges are read from the meter when it connects and whenever the wavelength changes: they depend on the sensor and shift slightly with the wavelength (S302C at 800 nm: 3.695 mW, 34.99 mW, 347.9 mW, 3.477 W).&lt;/p&gt;&lt;p&gt;Applied to the meter at once.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
