            </item>
            <item row="1" column="0">
             <widget class="QTabWidget" name="configTabs">
              <property name="currentIndex">
               <number>0</number>
              </property>
              <widget class="QWidget" name="peakSearchTab">
               <attribute name="title">
                <string>Peak search</string>
               </attribute>
               <layout class="QGridLayout" name="psGrid" columnstretch="0,1,0,1">
                <item row="0" column="0" colspan="2">
                 <widget class="QCheckBox" name="driftComp">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Temperature drift compensation&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Ticked: in every temperature scan (ScanT ticked, iTC connected, temperature points in the list), at each temperature point the stage1 THz peak is searched around TDS Ppos. Its shift Δ = new peak - TDS Ppos is added to iPos1, and to iPos2 with the direction set below, so the pump-THz delay stays the same at every temperature. Works the same in every scan mode.&lt;/p&gt;&lt;p&gt;Unticked: no search and no compensation. Scans without a temperature change are never compensated.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Drift comp.</string>
                  </property>
                  <property name="checked">
                   <bool>true</bool>
                  </property>
                  <property name="mytype" stdset="0">
                   <string>checkbox</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QLabel" name="psLabel_Ppos">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;TDS Ppos - stage1 THz peak position (mm)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;The stage1 position of the THz peak that belongs to the current iPos1 / iPos2. Enter it by hand after optimising the TDS; every successful search then updates it.&lt;/p&gt;&lt;p&gt;Not set: a compensated temperature scan will not start. The value is not kept after the program is closed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>TDS Ppos (mm)</string>
                  </property>
                  <property name="mytype" stdset="0">
                   <string>label</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="1">
                 <widget class="QDoubleSpinBox" name="TDS_Ppos">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;TDS Ppos - stage1 THz peak position (mm)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;The stage1 position of the THz peak that belongs to the current iPos1 / iPos2. Enter it by hand after optimising the TDS; every successful search then updates it.&lt;/p&gt;&lt;p&gt;Not set: a compensated temperature scan will not start. The value is not kept after the program is closed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="buttonSymbols">
                   <enum>QAbstractSpinBox::ButtonSymbols::NoButtons</enum>
                  </property>
                  <property name="specialValueText">
                   <string>Not set</string>
                  </property>
                  <property name="decimals">
                   <number>3</number>
                  </property>
                  <property name="minimum">
                   <double>-1.000000000000000</double>
                  </property>
                  <property name="maximum">
                   <double>220.000000000000000</double>
                  </property>
                  <property name="value">
                   <double>-1.000000000000000</double>
                  </property>
                 </widget>
                </item>
                <item row="2" column="0">
                 <widget class="QLabel" name="psLabel_R1">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Round 1 - coarse search&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Step (um) and number of points on each side of TDS Ppos. Default 3 um x ±30 covers ±90 um.&lt;/p&gt;&lt;p&gt;Keep the step below the width of the THz peak, or the search can step over it. A maximum on the edge of this window counts as a failed search (the peak may have left the window).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Round1 step (um)</string>
