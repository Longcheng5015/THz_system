  <property name="styleSheet">
   <string notr="true">*[mytype=&quot;container&quot;] {
    border: 1px solid #000;
	border-color: rgb(0, 0, 0);
    border-radius: 4px;
}

*[mytype=&quot;splitline&quot;] {
    border-top: 1px solid black;
}

*[mytype=&quot;inst_disp&quot;]{
    background-color: black;
    color: red;
    font-weight: bold;
}

/* set chart broader */
/**[mytype=&quot;chart&quot;] {       
    border: 1px solid #000;
	border-color: rgb(0, 0, 0);
    border-radius: 4px;
}*/

/*set progress bar*/
QProgressBar {
    border: 1px solid #999;
    border-radius: 4px;
    text-align: center;
    padding: 2px;
}
QProgressBar::chunk {
    
    background-color: #FFB300;   /* Golden*/
}

*[mytype=&quot;led&quot;] {
    border: 1px solid #000;
	border-color: rgb(0, 0, 0);
    border-radius: 4px;
}

*[mytype=&quot;line&quot;] {
    border: 0px;
    border-top: 1px solid #C8C8C8;   /* 水平线：用 top 边 */
}

/**[mytype=&quot;arrowbutton&quot;] {
    border: 1px solid #000;
	border-color: rgb(0, 0, 0);
    border-radius: 0px;
}*/

/* Button display style*/
*[mytype=checkable_button]:checked {
    background-color: rgba(255, 170, 0, 100);
    border: 1px solid rgba(255, 140, 0, 200); 
   /*border-radius: 3px;*/
    border-style: inset; /* 让边框看起来内陷 */
    /* 让文字向右下角移动 1 像素，产生被按压的错觉 */
    padding-left: 1px; /* 假设默认是4px，这里加1 */
    padding-top: 1px;  /* 假设默认是4px，这里加1 */
}

*[mytype=clickable_button]:pressed {
    background-color: rgba(255, 170, 0, 100);
    border: 1px solid rgba(255, 140, 0, 200); 
    border-style: inset; /* 让边框看起来内陷 */
    /* 让文字向右下角移动 1 像素，产生被按压的错觉 */
    padding-left: 1px; /* 假设默认是4px，这里加1 */
    padding-top: 1px;  /* 假设默认是4px，这里加1 */
}

*[mytype=arrowbutton]:pressed {
    background-color: rgba(255, 170, 0, 100);
    border: 1px solid rgba(255, 140, 0, 200); 
    border-style: inset; /* 让边框看起来内陷 */
    /* 让文字向右下角移动 1 像素，产生被按压的错觉 */
    padding-left: 1px; /* 假设默认是4px，这里加1 */
    padding-top: 1px;  /* 假设默认是4px，这里加1 */
}

*[mytype=inst_manu] {
    border: 1px solid gray;
}</string>
